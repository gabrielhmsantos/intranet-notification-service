{
  "name": "notification-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "job:reminders": "node scripts/run-reminders-once.mjs",
    "simulate:cron": "node scripts/simulate-pg-cron.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "fastify": "^5.7.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
